{
  "name": "Infinite Jarvis",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Jarvis",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/start.sh",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Chave da API do Claude (ou rode `claude login` no terminal)"
    },
    "OWNER_PHONE": {
      "description": "Seu WhatsApp com DDI, ex.: +5511999999999"
    },
    "OWNER_NAME": {
      "description": "Como o Jarvis te chama"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
