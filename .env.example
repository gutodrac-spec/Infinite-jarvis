# No GitHub Codespaces, prefira cadastrar estes valores como "Codespaces secrets"
# (github.com > Settings > Codespaces > Secrets). O .env é opcional.

# --- Claude (use um dos dois) ---
ANTHROPIC_API_KEY=
# ou rode `claude login` no terminal com a sua assinatura

# --- Você ---
OWNER_PHONE=+5511999999999
OWNER_NAME=Guto

# --- Canais (padrão: tudo grátis) ---
WHATSAPP_PROVIDER=baileys        # baileys (grátis, QR code) | twilio (pago)
VOICE_PROVIDER=app               # app (grátis: chamada pelo navegador) | elevenlabs | twilio (pagos)

# --- Voz local ---
WHISPER_MODEL=base               # tiny (mais rápido) | base | small (entende melhor, mais lento)
PIPER_VOICE=pt_BR-faber-medium   # vozes: https://huggingface.co/rhasspy/piper-voices (pt_BR)
VAD_THRESHOLD=600                # aumente se ruído ambiente disparar a escuta

# --- Baileys ---
BAILEYS_PAIRING_NUMBER=          # opcional: parear por código em vez de QR

# URL pública. No Codespaces é detectada sozinha; fora dele use ngrok/cloudflared.
PUBLIC_URL=
# Gerado sozinho pelo scripts/start.sh se ficar vazio
JARVIS_SECRET=

# --- Memória ---
OBSIDIAN_VAULT=./vault
VAULT_GIT_SYNC=false             # true = commit/push do vault a cada ronda (deixe o repositório PRIVADO)

# --- Autonomia ---
HEARTBEAT_MINUTES=15
QUIET_HOURS_START=23
QUIET_HOURS_END=7
MAX_CALLS_PER_HOUR=2
MAX_MESSAGES_PER_HOUR=10

# --- Opcionais pagos ---
# ELEVENLABS_API_KEY=  ELEVENLABS_VOICE_ID=  ELEVENLABS_LLM=claude-haiku-4-5  ELEVENLABS_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_PHONE_NUMBER=  TWILIO_WHATSAPP_NUMBER=
