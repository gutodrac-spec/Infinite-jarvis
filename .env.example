# No GitHub Codespaces, prefira cadastrar estes valores como "Codespaces secrets"
# (github.com > Settings > Codespaces > Secrets). O .env é opcional.

# --- Claude (use um dos dois) ---
ANTHROPIC_API_KEY=
# ou rode `claude login` no terminal com a sua assinatura

# --- Você ---
OWNER_PHONE=+5511999999999
OWNER_NAME=Guto

# --- Canais ---
WHATSAPP_PROVIDER=baileys        # baileys (WhatsApp Web, QR code) | twilio
VOICE_PROVIDER=elevenlabs        # elevenlabs (tempo real) | twilio (<Say> simples)

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # opcional: voz do Jarvis (Voice Library)
ELEVENLABS_LLM=claude-haiku-4-5  # modelo rápido que conduz a conversa por voz
ELEVENLABS_WEBHOOK_SECRET=       # opcional: webhook pós-ligação

# --- Twilio (número de telefone; também serve para WhatsApp se WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Baileys ---
BAILEYS_PAIRING_NUMBER=          # opcional: número do WhatsApp do Jarvis para parear por código em vez de QR

# URL pública. No Codespaces é detectada sozinha; fora dele use ngrok/cloudflared.
PUBLIC_URL=
# Gerado sozinho pelo scripts/start.sh se ficar vazio
JARVIS_SECRET=

# --- Memória ---
OBSIDIAN_VAULT=./vault
VAULT_GIT_SYNC=false             # true = commit/push do vault a cada ronda (deixe o repositório PRIVADO)

# --- Autonomia ---
HEARTBEAT_MINUTES=15
QUIET_HOURS_START=23
QUIET_HOURS_END=7
MAX_CALLS_PER_HOUR=2
MAX_MESSAGES_PER_HOUR=10
